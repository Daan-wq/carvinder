generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Source {
  MARKTPLAATS
  AUTOSCOUT
  FACEBOOK
  AUCTION
  OTHER
}

enum Condition {
  NEW
  USED_GOOD
  USED_FAIR
  DAMAGED
}

enum FuelType {
  PETROL
  DIESEL
  LPG
  ELECTRIC
  HYBRID
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
  OTHER
}

enum MileageBucket {
  KM_0_50K
  KM_50_100K
  KM_100_150K
  KM_150_200K
  KM_200K_PLUS
}

enum ScrapeJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum DealTier {
  OUTSTANDING
  GREAT
  FAIR
  HIGH
  OVERPRICED
}

enum ModelDeploymentStatus {
  TRAINING
  VALIDATION
  CHAMPION
  CHALLENGER
  ARCHIVED
}

model CarListing {
  id             String        @id @default(cuid())
  source         Source
  externalId     String
  url            String
  make           String
  model          String
  year           Int?
  mileage        Int?
  fuelType       FuelType?
  transmission   Transmission?
  condition      Condition?
  price          Int
  title          String
  description    String?
  imageUrls      String[]
  city           String?
  country        String        @default("NL")
  kenteken       String?
  rawData        Json?
  isActive       Boolean       @default(true)
  isSold         Boolean       @default(false)
  isPriceChanged Boolean       @default(false)
  listedAt       DateTime?
  scrapedAt      DateTime      @default(now())
  firstSeenAt    DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  priceHistory CarListingPriceHistory[]
  dealAlerts   DealAlert[]
  nlpFeatures  ListingNLPFeatures?
  taxData      ListingTaxData?
  mlPrediction MLPricePrediction?

  @@unique([source, externalId])
  @@index([make, model])
  @@index([source])
  @@index([isActive])
  @@index([price])
  @@index([year])
  @@index([kenteken])
  @@index([listedAt])
  @@map("car_listings")
}

model CarListingPriceHistory {
  id         String     @id @default(cuid())
  listingId  String
  listing    CarListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price      Int
  recordedAt DateTime   @default(now())

  @@index([listingId])
  @@index([recordedAt])
  @@map("car_listing_price_history")
}

model PriceProfile {
  id               String        @id @default(cuid())
  make             String
  model            String
  yearBucketStart  Int
  yearBucketEnd    Int
  mileageBucket    MileageBucket
  fuelType         FuelType
  condition        Condition
  sampleCount      Int
  averagePrice     Int
  medianPrice      Int
  p10Price         Int
  p90Price         Int
  lastCalculatedAt DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  dealAlerts DealAlert[]

  @@unique([make, model, yearBucketStart, yearBucketEnd, mileageBucket, fuelType, condition])
  @@index([make, model])
  @@map("price_profiles")
}

model DealAlert {
  id                 String             @id @default(cuid())
  listingId          String
  listing            CarListing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  profileId          String?
  profile            PriceProfile?      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mlPredictionId     String?
  mlPrediction       MLPricePrediction? @relation(fields: [mlPredictionId], references: [id], onDelete: SetNull)
  listingPrice       Int
  averagePrice       Int
  discountPercent    Float
  discountEuros      Int
  dealTier           DealTier?
  dealScore          Float?
  confidence         Float?
  isMLGenerated      Boolean            @default(false)
  notificationSentAt DateTime?
  isAcknowledged     Boolean            @default(false)
  createdAt          DateTime           @default(now())

  @@index([isAcknowledged])
  @@index([createdAt])
  @@index([listingId])
  @@index([dealTier])
  @@map("deal_alerts")
}

model WatchedSearch {
  id                    String    @id @default(cuid())
  make                  String
  model                 String?
  yearMin               Int?
  yearMax               Int?
  mileageMax            Int?
  maxPrice              Int?
  alertThresholdPercent Int       @default(15)
  sources               Source[]
  isActive              Boolean   @default(true)
  lastScrapedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("watched_searches")
}

model ScrapeJob {
  id            String          @id @default(cuid())
  source        Source
  status        ScrapeJobStatus @default(PENDING)
  listingsFound Int             @default(0)
  newListings   Int             @default(0)
  priceChanges  Int             @default(0)
  errors        String[]
  durationMs    Int?
  creditsUsed   Int             @default(0)
  startedAt     DateTime        @default(now())
  completedAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([source])
  @@index([status])
  @@index([createdAt])
  @@map("scrape_jobs")
}

model CreditUsage {
  id          String   @id @default(cuid())
  month       String
  creditsUsed Int      @default(0)
  creditLimit Int      @default(500)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([month])
  @@map("credit_usage")
}

model NotificationLog {
  id        String   @id @default(cuid())
  type      String
  dealCount Int      @default(0)
  message   String
  sentAt    DateTime @default(now())
  success   Boolean  @default(true)
  error     String?

  @@index([sentAt])
  @@map("notification_logs")
}

// --- ML Infrastructure Models ---

model RDWVehicleData {
  id                     String    @id @default(cuid())
  kenteken               String    @unique
  merk                   String?
  handelsbenaming        String?
  typeGoedkeuring        String?
  catalogusprijs         Int?
  gewicht                Int?
  cilinderinhoud         Int?
  vermogenKw             Int?
  co2Uitstoot            Int?
  euroKlasse             String?
  energielabel           String?
  brandstof              String?
  apkVervaldatum         DateTime?
  eersteKleur            String?
  eersteToelating        DateTime?
  eersteTenaamstellingNl DateTime?
  isGeexporteerd         Boolean   @default(false)
  rawData                Json?
  lastLookupAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  taxRecords ListingTaxData[]

  @@index([merk])
  @@map("rdw_vehicle_data")
}

model ListingNLPFeatures {
  id        String     @id @default(cuid())
  listingId String     @unique
  listing   CarListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  hasDamageKeywords     Boolean @default(false)
  hasNonRunningKeywords Boolean @default(false)
  hasNoApkKeywords      Boolean @default(false)
  hasExportKeywords     Boolean @default(false)
  hasProjectKeywords    Boolean @default(false)
  hasPremiumKeywords    Boolean @default(false)
  redFlagCount          Int     @default(0)
  redFlagScore          Float   @default(0)
  premiumFlagCount      Int     @default(0)
  premiumFlagScore      Float   @default(0)
  descriptionLength     Int     @default(0)
  descriptionQuality    Float   @default(0)
  photoCount            Int     @default(0)
  isPlaceholderPrice    Boolean @default(false)

  extractedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("listing_nlp_features")
}

model ListingTaxData {
  id        String          @id @default(cuid())
  listingId String          @unique
  listing   CarListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  rdwDataId String?
  rdwData   RDWVehicleData? @relation(fields: [rdwDataId], references: [id], onDelete: SetNull)

  bpmOriginal       Int?
  bpmRemaining      Int?
  bpmDepreciation   Float?
  mrbAnnual         Int?
  mrbProvince       String?
  isEuroCompliant   Boolean?
  milieuZoneWarning Boolean  @default(false)

  calculatedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([rdwDataId])
  @@map("listing_tax_data")
}

model MLModelVersion {
  id                  String                @id @default(cuid())
  version             String                @unique
  status              ModelDeploymentStatus @default(TRAINING)
  modelType           String
  trainingWindowStart DateTime
  trainingWindowEnd   DateTime
  trainingDatasetSize Int
  featureCount        Int

  rmseP50        Float?
  rmseP10        Float?
  rmseP90        Float?
  mapeP50        Float?
  coverageP10P90 Float?
  r2Score        Float?

  psiScore   Float?
  isChampion Boolean   @default(false)
  promotedAt DateTime?
  archivedAt DateTime?

  modelPath String?
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  predictions MLPricePrediction[]

  @@index([status])
  @@index([isChampion])
  @@map("ml_model_versions")
}

model MLPricePrediction {
  id             String         @id @default(cuid())
  listingId      String         @unique
  listing        CarListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  modelVersionId String
  modelVersion   MLModelVersion @relation(fields: [modelVersionId], references: [id])

  predictedP10 Int
  predictedP50 Int
  predictedP90 Int

  dealScore     Float
  dealTier      DealTier
  suspicionFlag Boolean  @default(false)

  modelConfidence   Float
  featureConfidence Float
  sampleConfidence  Float
  overallConfidence Float

  coverageLevel     Int      @default(1)
  hasSafetyCap      Boolean  @default(false)
  safetyCapReason   String?
  effectiveDealTier DealTier

  predictedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dealAlerts DealAlert[]

  @@index([dealTier])
  @@index([effectiveDealTier])
  @@index([modelVersionId])
  @@map("ml_price_predictions")
}
